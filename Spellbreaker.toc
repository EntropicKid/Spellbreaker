# ── Ядро: данные и схема ─────────────────────────────────────
# Порядок обязателен: Database заводит реестр SB.Data.Spells, в который
# пишут все файлы Spells\, а Migrations должен быть объявлен до того,
# как Init создаст AceDB и позовёт SB.Migrations.Run.
Core\Init.lua
Core\Events.lua
Core\Database.lua
Core\Migrations.lua

